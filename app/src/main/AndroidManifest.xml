<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Samo za preuzimanje fontova (Google Fonts) iz ekrana modula; Pravoslavac ovu dozvolu nema. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="Pravoslavac Dark">

        <!-- Bez ikone u launcheru: otvara se iz LSPosed-a (podešavanja modula) ili iz podešavanja u Pravoslavcu. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Pravoslavac Dark – fontovi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="LSPosed modul sa temama i dodatnim opcijama za aplikacije Православац и Житије светих." />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposedsharedprefs"
            android:value="true" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposedscope" />
    </application>

</manifest>